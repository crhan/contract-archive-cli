# 本地文档档案库 CLI - 环境变量模板
# 复制为 .env 后可在项目目录内覆盖配置；.env 已被 gitignore，不会泄露
#
# 推荐：secret/常用配置改用 `contract-archive config set`（落 ~/.config，文件 0600），
# 比项目目录的 .env 更安全。优先级：环境变量(含本 .env) > config 文件 > 默认值——
# 即本 .env 适合开发、Docker、临时覆盖模型，以及 env-only 的运行时旋钮。
# 可用 config set 等价配置的变量：
#   DASHSCOPE_API_KEY          → config set dashscope.api_key          <值>
#   DASHSCOPE_BASE_URL         → config set dashscope.base_url         <值>
#   DASHSCOPE_LLM_MODEL        → config set dashscope.model            <值>
#   DASHSCOPE_OCR_MODEL        → config set dashscope.ocr_model        <值>
#   DASHSCOPE_VL_MODEL         → config set dashscope.vl_model         <值>
#   DASHSCOPE_VL_EXTRACT_MODEL → config set dashscope.vl_extract_model <值>
#   CONTRACT_ARCHIVE_DIR       → config set archive.dir                <值>
# 其余是运行时旋钮，仅 env，不进 config 文件。

# ===== DashScope (阿里百炼) =====
# 用于字段抽取、VL OCR、签章核查和多源融合。
DASHSCOPE_API_KEY=

# 端点：默认国内站；如用国际站改为 https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# LLM 模型 ID
# 注意：qwen3.7-max 是用户在百炼控制台开通的特定别名。
# 公网用户调用 404 时改成账户能用的：qwen-max / qwen-max-latest / qwen3-max。
DASHSCOPE_LLM_MODEL=qwen3.7-max

# 逐页 VL OCR 模型。专用 OCR 模型只负责把扫描/表格页转写成 Markdown。
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-latest

# 多模态签章核查（看落款页图判甲乙方有无章/签字）所用的视觉模型，走 OpenAI 兼容接口。
# 默认 qwen3.6-flash（实测判得准且省）；要更准用 qwen3.6-plus。
# 注意 qwen3-vl-flash 实测会把空白落款误判成"有章"，勿用。
DASHSCOPE_VL_MODEL=qwen3.6-flash

# 多源融合"看图抽字段"所用视觉模型（保险等 enable_vision_fusion 类型，据图抽保额/免赔等高价值字段）。
# 通用 VL（需理解版式/表格），与纯 OCR 的 ocr_model、签章的 vl_model 分开可配。config set dashscope.vl_extract_model
DASHSCOPE_VL_EXTRACT_MODEL=qwen3.6-flash

# ===== 多源融合 / 并发（运行时旋钮，仅 env，不进 config 文件）=====
# LLM 调用并发度（逐页 OCR / 看图抽字段 / 多字段评判共用线程池）。默认 4。
# CONTRACT_ARCHIVE_LLM_CONCURRENCY=4
# 单文档允许走 VL OCR 的最大页数，防误喂超大 PDF。默认 500。
# CONTRACT_ARCHIVE_VL_OCR_MAX_PAGES=500
# VL OCR 渲染页图 DPI。默认 160。
# CONTRACT_ARCHIVE_VL_OCR_DPI=160
# 逐页 VL OCR SDK 重试次数。默认 4。
# CONTRACT_ARCHIVE_VL_OCR_RETRIES=4
# 融合"看图抽字段"单文档最多看几页（优先表格/扫描页）。防超大文档烧太多看图调用。默认 20。
# CONTRACT_ARCHIVE_VISION_FUSION_MAX_PAGES=20
# 融合低置信阈值 [0,1]：整体置信低于此 → 标 low_confidence、触发 agent 兜底（本期 no-op）。默认 0.6。
# CONTRACT_ARCHIVE_FUSION_THRESHOLD=0.6

# ===== 档案库 =====
# 档案库根目录；优先级：CLI --archive > 此变量 > XDG 默认
# 不设则默认 $XDG_DATA_HOME/contract-archive（即 ~/.local/share/contract-archive）
# 想自定义再取消注释，例如：
# CONTRACT_ARCHIVE_DIR=~/Documents/contract-archive

# ===== 评测（仅开发/质量门禁用）=====
# 评测数据集根目录（私有数据集仓库的 dataset/）。不设则回退主仓库内合成 cases（CI smoke）。
# 改 prompt/模型/流水线后须指向私有数据集跑 evals.run/report 过 gate 才提交。详见 evals/README.md。
# CONTRACT_ARCHIVE_EVALSET_DIR=~/project/contract-archive-evalset/dataset

# ===== 通用 =====
# 计算设备：auto 会依次试 MPS → CUDA → CPU；可硬编码 mps / cuda / cpu
COMPUTE_DEVICE=auto

# 日志级别
LOG_LEVEL=INFO
